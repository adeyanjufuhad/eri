{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev"],
      "port": 3000
    },
    {
      "name": "web-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "start", "--", "-p", "3100"],
      "port": 3100
    },
    {
      "name": "app-web",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "cd app && python -m http.server 8090 --bind 127.0.0.1 -d build/web"],
      "port": 8090
    }
  ]
}
